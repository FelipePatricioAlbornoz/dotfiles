            "color": "#45a172",
            "font_style": null,
            "font_weight": 700
          },
          "constant": {
            "color": "#98f6c0",
            "font_style": null,
            "font_weight": null
          },
          "property": {
            "color": "#bec9bf",
            "font_style": null,
            "font_weight": null
          },
          "variable": {
            "color": "#dfe4de",
            "font_style": null,
            "font_weight": null
          },
          "punctuation": {
            "color": "#88948a",
            "font_style": null,
            "font_weight": null
          },
          "operator": {
            "color": "#ffb4ab",
            "font_style": null,
            "font_weight": null
          },
          "tag": {
            "color": "#45a172",
            "font_style": null,
            "font_weight": null
          },
          "attribute": {
            "color": "#006d44",
            "font_style": null,
            "font_weight": null
          }
