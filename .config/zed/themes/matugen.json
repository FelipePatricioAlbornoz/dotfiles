          "comment.doc": {
            "color": "#bec9bf",
            "font_style": "italic",
            "font_weight": null
          },
          "function": {
            "color": "#ffb3b5",
            "font_style": null,
            "font_weight": null
          },
          "function.builtin": {
            "color": "#ffdada",
            "font_style": null,
            "font_weight": 700
          },
          "type": {
            "color": "#006d44",
            "font_style": null,
            "font_weight": null
