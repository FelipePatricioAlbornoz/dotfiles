{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Matugen",
  "author": "matugen",
  "themes": [
    {
      "name": "Matugen Dark",
      "appearance": "dark",
      "style": {
        "background": "#{{colors.background.default.hex_stripped}}",
        "editor.background": "#{{colors.background.default.hex_stripped}}",
        "editor.foreground": "#{{colors.on_surface.default.hex_stripped}}",
        "editor.line_number": "#{{colors.outline.default.hex_stripped}}",
        "editor.active_line_number": "#{{colors.on_surface_variant.default.hex_stripped}}",
        "editor.selection.background": "#{{colors.primary_container.default.hex_stripped}}",
        "editor.active_line.background": "#{{colors.surface_container.default.hex_stripped}}",
        "panel.background": "#{{colors.surface_container_low.default.hex_stripped}}",
        "tab_bar.background": "#{{colors.surface_container_low.default.hex_stripped}}",
        "tab.active_background": "#{{colors.surface_container.default.hex_stripped}}",
        "tab.inactive_background": "#{{colors.surface_container_low.default.hex_stripped}}",
        "toolbar.background": "#{{colors.surface_container_low.default.hex_stripped}}",
        "status_bar.background": "#{{colors.surface_container_low.default.hex_stripped}}",
        "title_bar.background": "#{{colors.surface_container_low.default.hex_stripped}}",
        "border": "#{{colors.outline_variant.default.hex_stripped}}",
        "border.variant": "#{{colors.outline_variant.default.hex_stripped}}",
        "text": "#{{colors.on_surface.default.hex_stripped}}",
        "text.muted": "#{{colors.on_surface_variant.default.hex_stripped}}",
        "text.placeholder": "#{{colors.outline.default.hex_stripped}}",
        "text.accent": "#{{colors.primary_container.default.hex_stripped}}",
        "icon": "#{{colors.on_surface_variant.default.hex_stripped}}",
        "icon.accent": "#{{colors.primary_container.default.hex_stripped}}",
        "link_text.hover": "#{{colors.primary_container.default.hex_stripped}}",
        "error": "#{{colors.error.default.hex_stripped}}",
        "error.border": "#{{colors.error.default.hex_stripped}}",
        "warning": "#{{colors.tertiary.default.hex_stripped}}",
        "warning.border": "#{{colors.tertiary.default.hex_stripped}}",
        "success": "#{{colors.tertiary_fixed.default.hex_stripped}}",
        "success.border": "#{{colors.tertiary_fixed.default.hex_stripped}}",
        "syntax": {
          "keyword": {
            "color": "#{{colors.primary_container.default.hex_stripped}}",
            "font_style": null,
            "font_weight": 700
          },
          "string": {
            "color": "#{{colors.tertiary_fixed.default.hex_stripped}}",
            "font_style": null,
            "font_weight": null
          },
          "string.escape": {
            "color": "#{{colors.tertiary.default.hex_stripped}}",
            "font_style": null,
            "font_weight": null
          },
          "comment": {
            "color": "#{{colors.outline.default.hex_stripped}}",
            "font_style": "italic",
            "font_weight": null
          },
          "comment.doc": {
            "color": "#{{colors.on_surface_variant.default.hex_stripped}}",
            "font_style": "italic",
            "font_weight": null
          },
          "function": {
            "color": "#{{colors.tertiary.default.hex_stripped}}",
            "font_style": null,
            "font_weight": null
          },
          "function.builtin": {
            "color": "#{{colors.tertiary_fixed.default.hex_stripped}}",
            "font_style": null,
            "font_weight": 700
          },
          "type": {
            "color": "#{{colors.inverse_primary.default.hex_stripped}}",
            "font_style": null,
            "font_weight": null
          },
          "type.builtin": {
            "color": "#{{colors.inverse_primary.default.hex_stripped}}",
            "font_style": null,
            "font_weight": 700
          },
          "number": {
            "color": "#{{colors.primary_fixed.default.hex_stripped}}",
            "font_style": null,
            "font_weight": null
          },
          "boolean": {
            "color": "#{{colors.primary_container.default.hex_stripped}}",
            "font_style": null,
            "font_weight": 700
          },
          "constant": {
            "color": "#{{colors.primary_fixed.default.hex_stripped}}",
            "font_style": null,
            "font_weight": null
          },
          "property": {
            "color": "#{{colors.on_surface_variant.default.hex_stripped}}",
            "font_style": null,
            "font_weight": null
          },
          "variable": {
            "color": "#{{colors.on_surface.default.hex_stripped}}",
            "font_style": null,
            "font_weight": null
          },
          "punctuation": {
            "color": "#{{colors.outline.default.hex_stripped}}",
            "font_style": null,
            "font_weight": null
          },
          "operator": {
            "color": "#{{colors.error.default.hex_stripped}}",
            "font_style": null,
            "font_weight": null
          },
          "tag": {
            "color": "#{{colors.primary_container.default.hex_stripped}}",
            "font_style": null,
            "font_weight": null
          },
          "attribute": {
            "color": "#{{colors.inverse_primary.default.hex_stripped}}",
            "font_style": null,
            "font_weight": null
          }
        }
      }
    }
  ]
}
